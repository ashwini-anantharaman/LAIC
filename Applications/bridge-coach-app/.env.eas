# Deployed backends, baked into EAS-published bundles (Expo Go / native sharing).
#
# Applied ONLY by the `publish:*` npm scripts (via dotenv-cli). Deliberately NOT
# a standard .env file: Expo CLI auto-loads those into `expo start` (would point
# local dev at production) and into the Vercel web export (would fight the
# same-origin proxy in vercel.json). This file touches neither.
#
# Real env vars always win over this file (dotenv never overrides), so a value
# set in CI or the shell takes precedence.

# Bundling iOS + Android concurrently blows Node's default heap on Windows —
# the export dies with a native crash (exit 0xC0000409). More headroom fixes it.
NODE_OPTIONS=--max-old-space-size=8192

# These three mirror the bridge-coach-app Vercel project's production env —
# the same stack the deployed web app uses. If sign-in ever breaks with
# "invalid email or password" on a fresh publish, FIRST check these against
# `vercel env pull` on that project: pointing at a stale backend (e.g. the
# retired nexus-backend-teal) produces exactly that symptom.

# The Nexus backend (Vercel project `nexus-api`).
EXPO_PUBLIC_API_URL=https://nexus-api-rust-six.vercel.app

# The bridge platform's launch handoff (Quan-branch deployment — the same
# target the web app's vercel.json proxies to).
EXPO_PUBLIC_BRIDGE_LAUNCH_URL=https://bridge-platform-git-quan-the-nexus-dev-team.vercel.app/nexus/launch

# The learning platform (Vercel project `nexus-learning`).
EXPO_PUBLIC_LEARNING_URL=https://nexus-learning-five.vercel.app
