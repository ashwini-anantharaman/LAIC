# --- Nexus context mode ---------------------------------------------------
# "stub": seeded dev users, no auth required (default for development).
#         A dev user picker at /welcome replaces login.
# "http": real Nexus context via TheNexusPlatform backend
#         GET /api/platform/bridge/context (lands in Phase 10) using the
#         Supabase session JWT. Do not enable before Phase 10.
NEXUS_CLIENT_MODE=stub

# --- http mode only --------------------------------------------------------
# Base URL of TheNexusPlatform FastAPI backend.
NEXUS_API_BASE_URL=http://localhost:8000

# Shared Supabase project (same one TheNexusPlatform uses — shared identity:
# nexusUserId = Supabase auth user id).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
