# --- Nexus context mode ---------------------------------------------------
# "stub": seeded dev users, no auth required (default for development).
#         A dev user picker at /welcome replaces login.
# "http": real Nexus context via TheNexusPlatform backend —
#         GET /api/platform/bridge/context (LIVE since Nexus integration
#         Phase 3). Entry flow: Nexus's "Launch Bridge Platform" hands off to
#         /nexus/launch with a single-use launch token; the exchanged session
#         token rides an httpOnly cookie and Nexus decides access from the
#         person's program role (bridge area grant → bridge_learner/coach/
#         reviewer/program_admin). Requires NEXUS_API_BASE_URL; on the Nexus
#         side set BRIDGE_PLATFORM_URL to this app's origin.
NEXUS_CLIENT_MODE=stub

# --- http mode only --------------------------------------------------------
# Base URL of TheNexusPlatform backend (backend-ts, Hono).
NEXUS_API_BASE_URL=http://localhost:8000

# Optional fallback credential: a shared Supabase session (same project as
# TheNexusPlatform). Not needed for the launch-token flow above.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- knowledge extraction (Phase 13, optional) ------------------------------
# Enables the "Extract items (LLM)" button on uploaded source documents.
# Without it, upload + manual authoring + generation still work fully.
ANTHROPIC_API_KEY=
# Optional model override for extraction (default claude-opus-4-8).
BRIDGE_EXTRACTOR_MODEL=

# --- BEN, the neural engine (optional) ---------------------------------------
# BEN (github.com/lorserker/ben, GPL-3.0) runs as its OWN service — never
# bundled here. With an endpoint configured, "BEN · neural engine" becomes
# seatable at any table seat and appears under Players → AI players.
# Without it, everything else works; the option simply isn't offered.
BEN_ENDPOINT=
# The ben-service Vercel project sits behind deployment protection; this is
# its "Protection Bypass for Automation" secret (ben-service → Settings →
# Deployment Protection). Ask a team admin — never commit the value.
BEN_PROTECTION_BYPASS=
# BEN runs simulations for card play; leads can take ~40s warm, minutes cold.
BEN_TIMEOUT_MS=180000
