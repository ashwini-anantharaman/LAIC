{
  "name": "@bridge/sessions",
  "version": "0.1.0",
  "private": true,
  "description": "Persistent bridge sessions: event-sourced session records, tenant-scoped access, stateless act/step/undo service over the engine's primed-history reconstruction. Store seam: memory (tests), JSON file (dev), Postgres (db/migrations).",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./fileStore": {
      "types": "./src/fileStore.ts",
      "default": "./src/fileStore.ts"
    }
  },
  "scripts": {
    "build": "tsc --noEmit",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@bridge/config": "workspace:*",
    "@bridge/engine": "workspace:*",
    "@bridge/events": "workspace:*",
    "@laic/learner-contracts": "link:../../../../Components/laic-learner-contracts"
  },
  "devDependencies": {
    "@bridge/knowledge": "workspace:*"
  }
}
