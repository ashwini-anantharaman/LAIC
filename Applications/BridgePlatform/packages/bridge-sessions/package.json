{
  "name": "@bridge/sessions",
  "version": "0.2.0",
  "private": true,
  "description": "Sessions v2 (Knowledge Rework Stage F): event-sourced play sessions pinned to a CompiledKb + per-seat player-config snapshots, with full decision logs for the verification-first table.",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": { "types": "./src/index.ts", "default": "./src/index.ts" },
    "./fileStore": { "types": "./src/fileStore.ts", "default": "./src/fileStore.ts" }
  },
  "scripts": {
    "build": "tsc --noEmit",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@bridge/config": "workspace:*",
    "@bridge/engine": "workspace:*",
    "@bridge/events": "workspace:*",
    "@bridge/kb": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
