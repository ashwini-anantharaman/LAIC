{
  "name": "@bridge/profiles",
  "version": "0.2.0",
  "private": true,
  "description": "Identity layer: per-user table preferences, bridge-owned org profiles (§3.4), and coach affiliations with explicit context switching (§3.5). AI player configuration moved to @bridge/kb in the knowledge rework.",
