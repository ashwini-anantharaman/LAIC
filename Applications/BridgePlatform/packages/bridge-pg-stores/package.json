{
  "name": "@bridge/pg-stores",
  "version": "0.1.0",
  "private": true,
  "description": "Supabase/Postgres implementations of the store seams (identity + knowledge-base model) over the db/migrations schema. Server-side only.",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "scripts": {
    "build": "tsc --noEmit",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@bridge/access": "workspace:*",
    "@bridge/challenges": "workspace:*",
    "@bridge/table-config": "workspace:*",
    "@bridge/audit": "workspace:*",
    "@bridge/kb": "workspace:*",
    "@bridge/profiles": "workspace:*",
    "@supabase/supabase-js": "^2.110.1",
    "@bridge/sessions": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^24.13.2"
  }
}