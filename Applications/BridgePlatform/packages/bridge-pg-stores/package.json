{
  "name": "@bridge/pg-stores",
  "version": "0.1.0",
  "private": true,
  "description": "Supabase/Postgres implementations of the four store seams (knowledge / sessions / profiles / progress) over the db/migrations schema. Server-side only: uses the service-role key (RLS bypass; tenant checks live in the service layer by design).",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "scripts": {
    "build": "tsc --noEmit",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@bridge/audit": "workspace:*",
    "@bridge/events": "workspace:*",
    "@bridge/knowledge": "workspace:*",
    "@bridge/profiles": "workspace:*",
    "@bridge/progress": "workspace:*",
    "@bridge/sessions": "workspace:*",
    "@supabase/supabase-js": "^2.45.0"
  },
  "devDependencies": {
    "@types/node": "^24.13.2"
  }
}
