{
  "name": "@laic/coach",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "LAIC Generalizable Coach — a UI-agnostic adaptive coaching engine (Bridge domain)",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./source": "./index.ts"
  },
  "files": [
    "dist",
    "index.ts",
    "platform",
    "domains"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "dev": "node --env-file-if-exists=.env --watch --import tsx domains/bridge/api/server.ts",
    "start": "node --env-file-if-exists=.env --import tsx domains/bridge/api/server.ts"
  },
  "dependencies": {
    "better-sqlite3": "^12.11.1",
    "express": "^4.19.2",
    "tsx": "^4.16.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.0",
    "tsup": "^8.0.0",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  }
}
