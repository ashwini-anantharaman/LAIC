{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://laic.nexus/coach/contracts/CoachingPolicy.schema.json",
  "title": "CoachingPolicy",
  "description": "The flat, resolved behavioral rules the runtime consumes, produced by collapsing the config inheritance chain (platform default → profile → course → class → learner prefs → session). See LAIC architecture §8.3, CPIP §9.",
  "type": "object",
  "required": ["schemaVersion", "interventionMode", "maxHintLevel"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "type": "string" },
    "interventionMode": {
      "type": "string",
      "enum": ["passive", "on_demand", "guided_tutor", "live_coach", "postmortem", "guided_replay", "human_coach_assistant"]
    },
    "maxHintLevel": { "type": "integer", "minimum": 0, "maximum": 5 },
    "allowDirectAnswer": { "type": "boolean" },
    "feedbackStyle": { "type": "string", "enum": ["gentle", "direct", "socratic", "minimal", "mixed"] },
    "questioningStyle": { "type": "string", "enum": ["socratic", "direct", "mixed"] },
    "interruptionTolerance": { "type": "string", "enum": ["low", "medium", "high"] },
    "postmortemVsRealtime": { "type": "string", "enum": ["prefer_realtime", "prefer_postmortem"] },
    "saveForPostmortemWhenPossible": { "type": "boolean" },
    "enabledTools": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Subset of the host's registered tools this policy permits."
    },
    "crossScopeAwareness": { "type": "boolean", "description": "Cross-domain awareness in dialogue; OFF by default (LPIP §5.4)." },
    "provenance": {
      "type": "object",
      "description": "Which CoachingPolicyProfile version produced this resolved policy (config versioning, §8.5).",
      "additionalProperties": false,
      "properties": {
        "profileId": { "type": "string" },
        "schemaVersion": { "type": "string" }
      }
    }
  }
}
