{
  // A TYPE GATE, at last.
  //
  // This project had no tsconfig.json and no typescript dependency, so `npx tsc`
  // resolved nothing, printed nothing and exited 0 — a green light that proved
  // only that tsc had not run. Anything that reads "typechecked" without this
  // file present in the repo is reading a lie.
  //
  // `npm run typecheck` is the gate. It is deliberately NOT `strict`: the app was
  // generated by Figma Make and carries thousands of implicit `any`s that are not
  // this change's business to fix. What it does catch is the class of mistake
  // that actually bites here — a prop that does not exist, a field spelled two
  // ways across the save/re-open round trip, a union member handled nowhere.
  // Tighten it a flag at a time as the sea of errors is drained.
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "types": ["vite/client"],
    "allowJs": true,
    "checkJs": false,
    "noEmit": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "allowSyntheticDefaultImports": true,
    "skipLibCheck": true,
    "strict": false,
    "noImplicitAny": false,
    "forceConsistentCasingInFileNames": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": ["src"],
  // The vendored bundle is a BUILD ARTIFACT of @bridge/table-embed, and its
  // emitted .d.ts still import "@bridge/engine" — packages that do not exist on
  // this side. Checking them would fail on the package's own module graph rather
  // than on anything written here, so the artifact is excluded and the consuming
  // code sees `any`. The real type check for that component happens where it is
  // built: `pnpm exec tsc --noEmit` in packages/bridge-table-embed.
  "exclude": ["src/vendor/bridge-table"]
}
