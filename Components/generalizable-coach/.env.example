# --- LLM (model-router layer) ----------------------------------------------
# The coach LLM client speaks to OpenAI or Anthropic. Provide one key.
# Get an OpenAI key at https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-openai-key-here
OPENAI_MODEL=gpt-4o-mini
# ANTHROPIC_API_KEY=sk-ant-your-key-here
# ANTHROPIC_MODEL=claude-sonnet-5
# LLM_PROVIDER=openai            # force a provider (else inferred)

# --- Coach service (M0) -----------------------------------------------------
COACH_PORT=3100

# --- Learning Platform integration (M4) -------------------------------------
# When LEARNING_PLATFORM_URL is set, a course_learning chat session retrieves
# knowledge from the Learning Platform's /retrieve (OwlwiseStudio) instead of
# the bundled demo corpus. COACH_SERVICE_TOKEN must match the value on Owlwise.
# LEARNING_PLATFORM_URL=http://localhost:3001
# COACH_SERVICE_TOKEN=choose-a-shared-secret

# --- Persistence ------------------------------------------------------------
# M0 uses an in-memory event log by default (headless-testable). The durable
# adapter target is Postgres (architecture §16.3, `activity_events` table).
# DATABASE_URL=postgres://user:pass@localhost:5432/laic_coach
COACH_DB=./coach.db              # sqlite path for the bridge demo API

# --- Auth (consumed from Nexus) ---------------------------------------------
# In production the coach verifies sessions/entitlements against Nexus. Not
# required for M0 local runs or tests.
# NEXUS_AUTH_URL=
# NEXUS_AUTH_AUDIENCE=
