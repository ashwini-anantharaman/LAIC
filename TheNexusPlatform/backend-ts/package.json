{
  "name": "owlwise-platform-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Life in AI Center / Nexus Platform API (TypeScript / Hono port of the FastAPI backend)",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "build:fn": "esbuild api/index.ts --bundle --platform=node --format=esm --packages=external --outfile=api/index.mjs",
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "migrate": "tsx scripts/runMigrations.ts",
    "seed:admin": "tsx scripts/seedPlatformAdmin.ts",
    "import:local": "tsx scripts/importLocalToPostgres.ts",
    "parity": "tsx scripts/parityCheck.ts",
    "build:vercel": "esbuild src/vercelEntry.ts --bundle --platform=node --target=node20 --format=esm --outfile=api/index.mjs --banner:js=\"import { createRequire } from 'module'; const require = createRequire(import.meta.url);\""
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.39.0",
    "@aws-sdk/client-s3": "^3.1085.0",
    "@aws-sdk/s3-request-presigner": "^3.1085.0",
    "@hono/node-server": "^1.13.7",
    "@supabase/supabase-js": "^2.47.10",
    "dotenv": "^16.4.7",
    "drizzle-orm": "^0.36.4",
    "hono": "^4.6.14",
    "postgres": "^3.4.5",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}