# Copy this file to `.env` and fill in real values.
# Env var names are identical to the Python backend, so an existing `.env` works.

# Anthropic Claude API key — https://console.anthropic.com/
ANTHROPIC_API_KEY=your_anthropic_api_key_here
# Optional model override (defaults to claude-sonnet-4-5)
CLAUDE_MODEL=claude-sonnet-4-5

# Supabase — project settings > API. Service-role key is server-side only.
SUPABASE_URL=your_supabase_url_here
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# Primary frontend origin (student app). Set to your Vercel production URL.
FRONTEND_ORIGIN=http://localhost:5173

# Comma-separated extra CORS origins (platform admin Vercel URL, custom domains).
# Example: https://owlwise-platform.vercel.app
EXTRA_CORS_ORIGINS=

# Bridge Program integration (config-seeded roles until a grant UI exists).
LAIC_ORG_ID=org_laic
BRIDGE_PROGRAM_ADMIN_EMAILS=
BRIDGE_REVIEWER_EMAILS=

# Postgres connection string for `npm run migrate` (optional).
# DATABASE_URL=postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres

# Port for the API server (defaults to 8000, matching uvicorn).
PORT=8000
