      "id": "app.content.create.personal",
      "label": "Add content just for themselves",
      "description": "Author privately, without publishing it to the club",
      "group": "club_content"
    },
    {
      "id": "app.content.edit",
      "label": "Edit content",
      "description": "Change content after it has been saved",
      "group": "club_content"
    },
    {
