    {
      "id": "learning.repository.organize",
      "label": "Organize repository collections and metadata",
      "description": "Organize repository collections and metadata",
      "group": "repository"
    },
    {
      "id": "learning.analytics.view",
      "label": "View learning and authoring analytics",
      "description": "View learning and authoring analytics",
      "group": "administration"
    },
    {
      "id": "learning.library.console",
      "label": "Open the Content Library as a program tab",
      "description": "Reveals the Content Library at the program level, outside the full Content Studio. The tab a Content Manager gets instead of the whole Studio.",
      "group": "library_governance"
    },
    {
      "id": "learning.library.share_view",
      "label": "See which clubs content is shared with",
      "description": "Read the per-club grants on an object. Split from granting because 'who can see this?' is a question a reviewer or coordinator asks without being the one who answers it.",
      "group": "library_governance",
      "resourceTypes": [
        "learning_object",
        "evaluation_object",
        "learning_composition"
      ],
      "supportsResourceConstraints": true
    },
    {
      "id": "learning.library.share_club",
      "label": "Share content with specific clubs",
      "description": "Grant content to whole clubs. Its administrators decide what the club sees. Named individuals are a separate capability (share_member).",
      "group": "library_governance",
      "resourceTypes": [
        "learning_object",
        "evaluation_object",
        "learning_composition"
      ],
      "supportsResourceConstraints": true
    },
    {
      "id": "learning.library.share_member",
      "label": "Share content with individual members",
      "description": "Grant content to named people in the program — including members who belong to no club. Separate from sharing with a club, so a role can reach one without the other.",
      "group": "library_governance",
      "resourceTypes": [
        "learning_object",
        "evaluation_object",
        "learning_composition"
      ],
      "supportsResourceConstraints": true
    },
    {
      "id": "learning.publish.app_target",
      "label": "Publish content to an app",
      "description": "It goes live in the app. Stronger than sharing with the app's administrators, because this is the decision rather than the offer.",
      "group": "library_governance",
      "resourceTypes": [
        "learning_object",
        "evaluation_object",
        "learning_composition"
      ],
      "supportsResourceConstraints": true
    },
    {
      "id": "learning.roles.delegate",
      "label": "Create and edit sub-roles",
      "description": "Mint roles inside the Content Studio, clamped to the creator's own capabilities. A holder can never grant what they do not themselves hold.",
      "group": "library_governance"
    },
    {
      "id": "learning.library.export",
      "label": "Export the library snapshot",
      "description": "Download the whole library — every object and folder — as a JSON snapshot. Ungoverned before this capability existed.",
      "group": "library_governance"
    },
    {
      "id": "learning.library.share_app",
      "label": "Share content with an app's administrators",
      "description": "They see it and decide whether to carry it. Sharing alone puts nothing on the app — publishing does that.",
      "group": "library_governance",
      "resourceTypes": [
        "learning_object",
        "evaluation_object",
        "learning_composition"
      ],
      "supportsResourceConstraints": true
    },
    {
      "id": "learning.app.administer",
      "label": "Administer an app's content",
      "description": "See what has been granted to an app you administer, and choose what goes on it. Which apps someone administers is set per program, beside the content library.",
      "group": "library_governance",
      "resourceTypes": [
        "learning_object",
        "evaluation_object",
        "learning_composition"
      ],
      "supportsResourceConstraints": true
    },
    {
      "id": "learning.app.publish_club",
      "label": "Choose which club sees content on the app",
      "description": "Publish to an app for one club rather than everyone on it. Separate from publishing itself, because 'which app' and 'which club within it' are different decisions — an app's administrators hold both for the app they run.",
      "group": "library_governance",
      "resourceTypes": [
        "learning_object",
        "evaluation_object",
        "learning_composition"
      ],
      "supportsResourceConstraints": true
    },
    {
      "id": "learning.library.upload",
      "label": "Add files to the library",
      "description": "Add a PDF, video or image directly to the content library and file it into folders. Not authored content — material that arrives ready-made.",
      "group": "library_governance",
      "resourceTypes": [
        "learning_object",
        "evaluation_object",
        "learning_composition"
      ],
      "supportsResourceConstraints": true
    },
    {
      "id": "learning.library.folder_manage",
      "label": "Create and organize library folders",
      "description": "Create, rename and remove folders in the program Content Library, including subfolders. Folders only — this never creates content. Removing a folder unfiles what was in it and never deletes it.",
      "group": "library_governance",
      "resourceTypes": [
        "learning_object",
        "evaluation_object",
        "learning_composition"
      ],
      "supportsResourceConstraints": true
    },
    {
      "id": "learning.library.file_content",
      "label": "Publish Studio content into a library folder",
      "description": "Take a tutorial or other object from the Content Studio and file it into a folder of the program Content Library. Limited to folders the holder can already see, so it can place content but never reach a folder that was not shared with them.",
      "group": "library_governance",
      "resourceTypes": [
        "learning_object",
        "evaluation_object",
        "learning_composition"
      ],
      "supportsResourceConstraints": true
    },
    {
      "id": "learning.studio.access",
      "label": "Open the Content Studio",
      "description": "Open the Content Studio itself — its library, its create flow, every object in the program. Separate from reviewing or editing one object's pipeline, which is granted per folder in the Content Library and needs no Studio access at all.",
      "group": "library_governance",
      "resourceTypes": [
        "learning_object",
        "evaluation_object",
        "learning_composition"
      ],
      "supportsResourceConstraints": true
    }
  ],
