# Copy this file to `.env` and fill in real values.
# The same three credentials exist in the older LIAC app's .env.local.

# Anthropic Claude API key — https://console.anthropic.com/
ANTHROPIC_API_KEY=your_anthropic_api_key_here
# Optional model override (defaults to claude-sonnet-4-5)
CLAUDE_MODEL=claude-sonnet-4-5

# Supabase — project settings > API. Service-role key is server-side only.
SUPABASE_URL=your_supabase_url_here
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# Primary frontend origin (student app). Set to your Vercel production URL.
FRONTEND_ORIGIN=http://localhost:5173

# Comma-separated extra CORS origins (platform admin Vercel URL, custom domains).
# Example: https://owlwise-platform.vercel.app
EXTRA_CORS_ORIGINS=

# Supabase anon key (optional, for future direct client auth)
SUPABASE_ANON_KEY=your_anon_key_here
