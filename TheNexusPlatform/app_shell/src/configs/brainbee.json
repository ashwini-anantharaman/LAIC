{
  "appId": "app_brainbee",
  "slug": "brainbee",
  "status": "preview",
  "version": "0.1.0",
  "identity": {
    "displayName": "Brain Bee Study",
    "shortName": "Brain Bee",
    "bundleId": "org.lifeinai.brainbee",
    "packageName": "org.lifeinai.brainbee"
  },
  "programContext": {
    "nexusOrgId": "org_laic",
    "programId": "program_brainbee",
    "defaultDomainId": "brainbee"
  },
  "branding": {
    "primaryColor": "#44318d",
    "secondaryColor": "#2b2452",
    "accentColor": "#e8a33d",
    "backgroundColor": "#f6f1e7",
    "surfaceColor": "#fffdf7",
    "textColor": "#241f33",
    "mutedColor": "#7a7263",
    "fontFamily": "'Lora', serif",
    "displayFontFamily": "'Fraunces', serif",
    "scheme": "light",
    "markGlyph": "◉"
  },
  "copy": {
    "welcomeTitle": "Welcome to Brain Bee Study",
    "welcomeSubtitle": "Learn neuroscience chapters with guided study, quizzes, and review.",
    "loginTitle": "Sign in to continue studying",
    "signupTitle": "Create your study account",
    "footerText": "A Life in AI Center program"
  },
  "auth": {
    "allowedMethods": ["email", "google"],
    "allowSelfSignup": true,
    "allowAdminEnrollment": true
  },
  "roleButtons": [
    {
      "key": "student",
      "label": "Student",
      "description": "Study chapters, take quizzes, track your progress",
      "roleRequested": "student",
      "entryFlow": "signup",
      "defaultRouteAfterLogin": "/learn/home",
      "visible": true,
      "sortOrder": 1
    },
    {
      "key": "teacher",
      "label": "Teacher / Admin",
      "description": "Manage your class and review student progress",
      "roleRequested": "course_admin",
      "entryFlow": "signin",
      "defaultRouteAfterLogin": "/learn/progress",
      "visible": true,
      "sortOrder": 2
    }
  ],
  "onboarding": {
    "questions": [
      {
        "key": "grade",
        "label": "What grade are you in?",
        "type": "single_select",
        "options": [
          { "label": "Grade 8 or below", "value": "8-" },
          { "label": "Grade 9–10", "value": "9-10" },
          { "label": "Grade 11–12", "value": "11-12" }
        ],
        "required": true,
        "visibleForRoles": ["student"]
      },
      {
        "key": "school",
        "label": "School name",
        "type": "text",
        "required": false
      }
    ],
    "requiredForRoles": ["student"]
  },
  "navigation": {
    "homeRoute": "/learn/home",
    "tabs": [
      { "key": "course", "label": "Course", "route": "/learn/home", "icon": "book", "requiredModule": "learning" },
      { "key": "progress", "label": "Progress", "route": "/learn/progress", "icon": "chart", "requiredModule": "learning" }
    ]
  },
  "enabledModules": { "learning": true, "bridge": false, "coaching": true },
  "featureFlags": {
    "aiStudyPanel": true,
    "coachButton": false,
    "chapterRegionRegistration": false
  },
  "entitlements": {
    "requiredEntitlementKeys": ["learning_basic"]
  },
  "build": {
    "appVariant": "brainbee",
    "runtimeTemplate": "learning-app",
    "environment": "dev",
    "configFrozenAtBuild": false
  }
}
