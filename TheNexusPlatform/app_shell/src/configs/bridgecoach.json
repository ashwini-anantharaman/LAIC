{
  "appId": "app_bridgecoach",
  "slug": "bridgecoach",
  "status": "preview",
  "version": "0.1.0",
  "identity": {
    "displayName": "Bridge Coach",
    "shortName": "Bridge Coach",
    "bundleId": "org.lifeinai.bridgecoach",
    "packageName": "org.lifeinai.bridgecoach"
  },
  "programContext": {
    "nexusOrgId": "org_laic",
    "programId": "program_bridge",
    "defaultDomainId": "bridge"
  },
  "branding": {
    "primaryColor": "#cfa75f",
    "secondaryColor": "#1f4234",
    "accentColor": "#d94f4f",
    "backgroundColor": "#0c1f17",
    "surfaceColor": "#142a1f",
    "textColor": "#f2ead8",
    "mutedColor": "#8fa295",
    "fontFamily": "'Public Sans', sans-serif",
    "displayFontFamily": "'Playfair Display', serif",
    "scheme": "dark",
    "markGlyph": "♠"
  },
  "copy": {
    "welcomeTitle": "Welcome to Bridge Coach",
    "welcomeSubtitle": "Practice bridge with configurable players, tutorials, analysis, and coaching.",
    "loginTitle": "Take your seat",
    "signupTitle": "Join the table",
    "footerText": "A Life in AI Center program"
  },
  "auth": {
    "allowedMethods": ["email", "google", "apple"],
    "allowSelfSignup": true,
    "allowAdminEnrollment": true
  },
  "roleButtons": [
    {
      "key": "player",
      "label": "Player",
      "description": "Practice hands, play the table, review your games",
      "roleRequested": "learner",
      "entryFlow": "signup",
      "defaultRouteAfterLogin": "/bridge/home",
      "visible": true,
      "sortOrder": 1
    },
    {
      "key": "coach",
      "label": "Coach",
      "description": "Coach players and review their play",
      "roleRequested": "coach",
      "entryFlow": "apply",
      "defaultRouteAfterLogin": "/coach/dashboard",
      "visible": true,
      "sortOrder": 2
    },
    {
      "key": "club",
      "label": "Club / Organization",
      "description": "Bring your club onto the platform",
      "roleRequested": "program_org_admin",
      "entryFlow": "apply",
      "defaultRouteAfterLogin": "/bridge/home",
      "visible": true,
      "sortOrder": 3
    }
  ],
  "onboarding": {
    "questions": [
      {
        "key": "experience",
        "label": "How much bridge have you played?",
        "type": "single_select",
        "options": [
          { "label": "Brand new", "value": "new" },
          { "label": "Casual player", "value": "casual" },
          { "label": "Club player", "value": "club" },
          { "label": "Tournament player", "value": "tournament" }
        ],
        "required": true
      },
      {
        "key": "club_name",
        "label": "Club or organization name",
        "type": "text",
        "required": false,
        "visibleForRoles": ["coach", "program_org_admin"]
      }
    ],
    "requiredForRoles": ["learner", "coach"]
  },
  "navigation": {
    "homeRoute": "/bridge/home",
    "tabs": [
      { "key": "table", "label": "The Table", "route": "/bridge/home", "icon": "cards", "requiredModule": "bridge" },
      { "key": "practice", "label": "Practice", "route": "/bridge/table", "icon": "target", "requiredModule": "bridge" },
      {
        "key": "coach",
        "label": "Coach Studio",
        "route": "/coach/dashboard",
        "icon": "whistle",
        "requiredModule": "coaching",
        "requiredEntitlement": "coaching_pro",
        "visibleForRoles": ["coach", "program_org_admin"]
      }
    ]
  },
  "enabledModules": { "learning": true, "bridge": true, "coaching": true },
  "featureFlags": {
    "bridgeTable": true,
    "aiPlayerProfiles": true,
    "coachButton": true,
    "pbnImport": true,
    "linImport": true,
    "coachUpsell": true
  },
  "entitlements": {
    "requiredEntitlementKeys": ["bridge_basic", "coaching_pro"],
    "coachUpsellEnabled": true,
    "upgradeRoute": "/bridge/home"
  },
  "build": {
    "appVariant": "bridgecoach",
    "runtimeTemplate": "bridge-app",
    "environment": "dev",
    "configFrozenAtBuild": false
  }
}
