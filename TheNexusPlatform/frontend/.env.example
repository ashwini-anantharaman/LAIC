# Platform admin UI — points at the FastAPI backend.
# Local dev:
VITE_API_URL=http://localhost:8000

# Vercel (separate project): set to your student/API deployment URL, e.g.
# VITE_API_URL=https://your-owlwise-app.vercel.app
#
# NOTE: the app currently boots straight into the self-contained platform
# prototype (see src/main.tsx) and makes NO API calls, so VITE_API_URL is not
# needed for the current Vercel deploy. It only matters if you restore the
# backend-connected login → dashboard flow.
